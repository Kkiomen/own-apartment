APP_NAME=Mieszkania
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

# Host port for the web container â€” the ONLY port this stack publishes.
# Give every app on the box its own number; 8080/8000/3000 are commonly taken.
# Everything else (Postgres, the queue, the scheduler) stays on private
# networks, so two apps can never collide over anything but this one value.
APP_PORT=8090

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL
APP_TIMEZONE=Europe/Warsaw

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# `postgres` is the compose service name, resolved on the internal network.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=apartment
DB_USERNAME=apartment
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
